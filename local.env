# Local Environment Variables
# This file is for local development only - add to .gitignore for production

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Redis Configuration
REDIS_HOST=127.0.0.1 
REDIS_PORT=6379
USE_SINGLE_INSTANCE_CACHE=true

# Simple Authentication (ACTIVE)
AUTH_SIMPLE_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=secure-local-password-123
AUTH_SERVICE_NAME=LS Keeper Data Frontend

# Session Configuration
SESSION_COOKIE_PASSWORD=the-password-must-be-at-least-32-characters-long
SESSION_COOKIE_SECURE=false

# App Configuration
APP_BASE_URL=http://localhost:3000

KEEPER_DATA_API_BASE_URL=http://localhost:5555
KEEPER_DATA_API_USERNAME=ApiKey
KEEPER_DATA_API_PASSWORD=integration-test-secret

# Keeper Data Bridge
KEEPER_DATA_BRIDGE_BASE_URL=http://localhost:5560

