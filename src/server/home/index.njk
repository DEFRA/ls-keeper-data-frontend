{% extends 'layouts/page.njk' %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Welcome to the Keeper Reference Data System (KRDS) Dashboard"
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="govuk-body" data-testid="app-page-body">
        {% if isAuthenticated %}
          <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
            <div class="govuk-notification-banner__header">
              <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">
                Success
              </h2>
            </div>
            <div class="govuk-notification-banner__content">
              <h3 class="govuk-notification-banner__heading">
                Welcome, {{ user.displayName }}!
              </h3>
              <p class="govuk-body">You are successfully authenticated with DEFRA ID.</p>
            </div>
          </div>
          
          <p class="govuk-body"><strong>User Details:</strong></p>
          <ul class="govuk-list govuk-list--bullet">
            <li><strong>Email:</strong> {{ user.email }}</li>
            <li><strong>Contact ID:</strong> {{ user.contactId }}</li>
            <li><strong>Service ID:</strong> {{ user.serviceId }}</li>
            <li><strong>Enrolments:</strong> {{ user.enrolmentCount }}</li>
          </ul>
          
          <div class="govuk-button-group">
            <a href="/auth/profile" class="govuk-button govuk-button--secondary">View Profile</a>
            <a href="/auth/logout" class="govuk-button govuk-button--warning">Logout</a>
          </div>
        {% else %}
          <p class="govuk-body">This is the KRDS Dashboard application. Please log in to access the system.</p>
          
          <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
              <span class="govuk-warning-text__assistive">Warning</span>
              You must be authenticated with DEFRA ID to access this service.
            </strong>
          </div>
          
          <a id="login-link" href="/auth/login" class="govuk-button govuk-button--start" data-module="govuk-button">
            LOGIN
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="m0 0h13l20 20-20 20H0l20-20z"></path>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

{% endblock %}
