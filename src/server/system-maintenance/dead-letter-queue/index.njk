{% extends 'layouts/page.njk' %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: caption
  }) }}

  {% if successMessage %}
    {{ govukNotificationBanner({
      type: "success",
      html: '<p class="govuk-notification-banner__heading">' + successMessage + '</p>'
    }) }}
  {% endif %}

  {% if error %}
    {{ govukErrorSummary({
      titleText: "There is a problem",
      errorList: [
        {
          text: error
        }
      ]
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      
      <p class="govuk-body">
        The Dead Letter Queue (DLQ) contains messages that failed to process in the data ingestion pipeline.
        Use this page to monitor failed messages and take corrective action.
      </p>

      {% if queueStats %}
        <h2 class="govuk-heading-m">Queue Statistics</h2>
        
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Messages available
            </dt>
            <dd class="govuk-summary-list__value">
              <strong class="govuk-tag govuk-tag--{{ 'red' if queueStats.approximateNumberOfMessages > 0 else 'green' }}">
                {{ queueStats.approximateNumberOfMessages }}
              </strong>
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Messages in flight
            </dt>
            <dd class="govuk-summary-list__value">
              {{ queueStats.approximateNumberOfMessagesNotVisible }}
            </dd>
          </div>
        </dl>

        {% if queueStats.approximateNumberOfMessages > 0 %}
          <h2 class="govuk-heading-m">Actions</h2>

          <p class="govuk-body">
            <strong>Peek:</strong> View up to 10 messages without removing them from the queue.
          </p>
          <p class="govuk-body">
            <strong>Redrive:</strong> Process up to 10 messages by moving them back to the main queue for reprocessing.
          </p>

          <div class="govuk-button-group">
            <a href="/system-maintenance/dead-letter-queue?action=peek&maxMessages=5" class="govuk-button govuk-button--secondary" data-module="govuk-button">
              Peek at messages
            </a>

            <form method="POST" action="/system-maintenance/dead-letter-queue/redrive" style="display: inline;">
              <input type="hidden" name="maxMessages" value="10">
              {{ govukButton({
                text: "Redrive messages",
                classes: "govuk-button--warning",
                attributes: {
                  onclick: "return confirm('Redrive up to 10 messages back to the main queue for reprocessing?')"
                }
              }) }}
            </form>
          </div>

          {% if messages %}
            <div class="govuk-!-margin-top-6">
              <h3 class="govuk-heading-s">Messages</h3>
              <p class="govuk-body"><strong>Found {{ messages.count }} message(s)</strong></p>
              <pre style="background: #f3f2f1; padding: 1rem; overflow-x: auto; font-size: 0.875rem;">{{ messages.messages | dump(2) }}</pre>
              <a href="/system-maintenance/dead-letter-queue" class="govuk-button govuk-button--secondary govuk-!-margin-top-4">Hide messages</a>
            </div>
          {% endif %}

          <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

          <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
              <span class="govuk-warning-text__assistive">Warning</span>
              Danger Zone
            </strong>
          </div>

          <h2 class="govuk-heading-m">Purge All Messages</h2>
          
          <p class="govuk-body">
            This will permanently delete <strong>all messages</strong> from the dead letter queue (not just 10). 
            <strong>This action cannot be undone.</strong>
          </p>

          <form method="POST" action="/system-maintenance/dead-letter-queue/purge">
            {{ govukButton({
              text: "Purge queue",
              classes: "govuk-button--warning",
              attributes: {
                onclick: "return confirm('WARNING: This will PERMANENTLY DELETE all messages from the dead letter queue.\\n\\nThis action CANNOT be undone.\\n\\nAre you sure you want to continue?')"
              }
            }) }}
          </form>

        {% else %}
          <p class="govuk-body govuk-!-margin-top-6">
            <strong class="govuk-tag govuk-tag--green">Queue is empty</strong>
          </p>
          <p class="govuk-body">
            There are no messages in the dead letter queue. The ingestion pipeline is processing messages successfully.
          </p>
        {% endif %}

      {% endif %}

    </div>
  </div>
{% endblock %}
